---

struct ByteArrayStruct {
    int size;
    const char *data;
    void (*freeData)(char *);
};

struct CommandResultStruct {
    int success;
    struct ByteArrayStruct data;
};

struct CommandRegistryStruct {
    const void *handle;
    int (*getSize)(const void *handle);
    void (*getCommands)(const void *handle, int *outTypes, void **outCommandHandles);
    struct CommandResultStruct (*runCommand)(const void *commandHandle, struct ByteArrayStruct parameter);
    void (*free)(struct CommandRegistryStruct *);
};

struct CommandRegistryManagerStruct {
    const void *handle;
    int (*addCommandRegistry)(const void *handle, struct CommandRegistryStruct registry);
};

struct CommandRunnerStruct {
    const void *handle;
    struct CommandResultStruct (*run)(const void *handle, int registryId, int commandType, struct ByteArrayStruct parameter);
};

struct PluginDependenciesStruct {
    struct CommandRegistryManagerStruct commandRegistryManager;
    struct CommandRunnerStruct commandRunner;
};